<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/install/index.php -f
    RewriteCond %{REQUEST_URI} !^/install/
    RewriteRule ^ - [F,L]
</IfModule>

<Files "*.txt">
    Require all denied
</Files>
<Files "error_log">
    Require all denied
</Files>
<FilesMatch "^(config|composer)\.php$">
    Require all denied
</FilesMatch>
<Files "*.sh">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.zip">
    Require all denied
</Files>
